# Rust / Cargo ---------------------------------------------------------------
/target
**/*.rs.bk
# Cargo.lock is deliberately NOT ignored: this crate has zero dependencies, so
# the lockfile is meaningful and cheap to keep in sync.

# WebAssembly build output (regenerated by ./build.sh) -----------------------
www/*.wasm
/pkg
/dist

# Headless tool artifacts (tools/smoke.js screenshots, tools/dbg-board.js) ----
www/*.png

# Node (only used for the dev tools under tools/) ----------------------------
node_modules/
npm-debug.log*
yarn-error.log*
coverage/
.nyc_output/

# Logs, scratch files, local caches -------------------------------------------
*.log
*.tmp
/tmp
__pycache__/
*.py[cod]

# Local config / secrets ------------------------------------------------------
.env
.env.local
*.local
!.env.example

# Editors / OS metadata -------------------------------------------------------
.vscode/
.idea/
*.iml
.fleet/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

